PORT=3000
# Optional real Linear workspace. Create a personal API key in Linear settings.
LINEAR_API_KEY=
LINEAR_ISSUE_ID=
# Optional signed Linear webhook for Issue and Comment events.
LINEAR_WEBHOOK_SECRET=
# Optional model review (contradiction detection + drift explanation) via the OpenAI Responses API.
# The gate stays deterministic without it; model findings can add a denial, never remove one.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Route through OpenRouter or another Responses-compatible gateway instead of api.openai.com:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
